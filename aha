			local Tween = game.TweenService:Create(EntityFrame.Frame,TweenInfo.new(5,Enum.EasingStyle.Linear),{Size = UDim2.fromScale(1,0.05)})
			Tween:Play()

			local Sound = Instance.new("Sound")
			Sound.SoundId = "rbxassetid://135385226837787"
